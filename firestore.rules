rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && myProfile().data.role == 'admin'
        && myProfile().data.active == true;
    }

    function isTeacherOrAdmin() {
      return signedIn()
        && myProfile().data.active == true
        && (myProfile().data.role == 'admin' || myProfile().data.role == 'teacher');
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /students/{id} {
      allow read, create, update, delete: if isTeacherOrAdmin();
    }

    match /attendance/{id} {
      allow read, create, update, delete: if isTeacherOrAdmin();
    }

    match /feeRecords/{id} {
      allow read, create, update, delete: if isTeacherOrAdmin();
    }

    // Keep remaining modules locked until each one is migrated.
    match /tests/{id} { allow read, write: if false; }
    match /questionBank/{id} { allow read, write: if false; }
    match /testAttempts/{id} { allow read, write: if false; }
  }
}
